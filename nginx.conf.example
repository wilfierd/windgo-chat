# Nginx Configuration for WindGo Chat Backend
# This replaces application-level rate limiting with efficient reverse proxy rate limiting

# Define rate limiting zones (stored in memory)
# Format: limit_req_zone $variable zone=name:size rate=rate;

# Zone for general API requests (60 requests per minute per IP)
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=60r/m;

# Zone for message posting (10 requests per minute per IP)
limit_req_zone $binary_remote_addr zone=message_limit:10m rate=10r/m;

# Zone for authentication endpoints (5 login attempts per minute)
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/m;

# Connection limit per IP (prevent too many concurrent connections)
limit_conn_zone $binary_remote_addr zone=conn_limit:10m;

upstream windgo_backend {
    # Your Go backend server
    server localhost:8080;

    # Optional: Add more backend servers for load balancing
    # server localhost:8081;
    # server localhost:8082;

    # Keep connections alive for better performance
    keepalive 32;
}

server {
    listen 80;
    server_name chat.yourdomain.com;  # Change this to your domain

    # Optional: Redirect HTTP to HTTPS
    # return 301 https://$server_name$request_uri;

    # Client body size limit (prevent huge uploads)
    client_max_body_size 10M;

    # Timeouts
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    # Limit concurrent connections per IP
    limit_conn conn_limit 20;

    # Logging
    access_log /var/log/nginx/windgo_access.log;
    error_log /var/log/nginx/windgo_error.log;

    # WebSocket endpoint (no rate limiting - connection itself is the limit)
    location /ws {
        proxy_pass http://windgo_backend;

        # WebSocket headers
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Preserve client information
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Longer timeouts for WebSocket
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Authentication endpoints (stricter rate limiting)
    location ~ ^/api/auth/(login|register) {
        # 5 requests per minute, burst of 3
        limit_req zone=auth_limit burst=3 nodelay;

        # Custom error page for rate limiting
        limit_req_status 429;

        proxy_pass http://windgo_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Message posting endpoints (moderate rate limiting)
    location ~ ^/api/v1/(messages|rooms/.*/messages) {
        # 10 requests per minute, burst of 5
        limit_req zone=message_limit burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://windgo_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # General API endpoints (general rate limiting)
    location /api/ {
        # 60 requests per minute, burst of 20
        limit_req zone=api_limit burst=20 nodelay;
        limit_req_status 429;

        proxy_pass http://windgo_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Health check endpoint (no rate limiting)
    location /health {
        proxy_pass http://windgo_backend;
        access_log off;  # Don't log health checks
    }

    # Root endpoint
    location / {
        proxy_pass http://windgo_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Custom error page for rate limiting (optional)
    error_page 429 @ratelimit;
    location @ratelimit {
        default_type application/json;
        return 429 '{"error":"Rate limit exceeded","message":"Too many requests. Please try again later."}';
    }
}

# Optional: HTTPS configuration
# server {
#     listen 443 ssl http2;
#     server_name chat.yourdomain.com;
#
#     # SSL certificates (use Let's Encrypt)
#     ssl_certificate /etc/letsencrypt/live/chat.yourdomain.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/chat.yourdomain.com/privkey.pem;
#
#     # SSL settings
#     ssl_protocols TLSv1.2 TLSv1.3;
#     ssl_ciphers HIGH:!aNULL:!MD5;
#     ssl_prefer_server_ciphers on;
#
#     # ... rest of the configuration (same as HTTP above)
# }
